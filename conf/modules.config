/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: FASTQC {
        ext.args = '--quiet'
    }

    withName: 'NFDATAOMICS_NANOTRANSEQ:NANOTRANSEQ:RAW_READS_QC:(FASTQC|TOULLIGQC|NANOPLOT)' {
        publishDir = [
            path: {
                def proc = task.process.tokenize(':')[-1]
                "${params.outdir}/qc/raw_reads/${meta.id}/${proc}"
            },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'NFDATAOMICS_NANOTRANSEQ:NANOTRANSEQ:CDNA_QC:(FASTQC|TOULLIGQC|NANOPLOT|CHOPPER)' {
        publishDir = [
            path: {
                def proc = task.process.tokenize(':')[-1]
                "${params.outdir}/qc/post_chopper/${meta.id}/${proc}"
            },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${task.process}".contains('CDNA_QC') ? "${params.outdir}/qc/post_chopper/MULTIQC" : "${params.outdir}/qc/raw_reads/MULTIQC" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MINIMAP2_INDEX' {
        publishDir = [
            path: {
                def proc = task.process.tokenize(':')[-1]
                "${params.outdir}/alignment/${proc}"
            },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MINIMAP2_ALIGN|PARABRICKS_MINIMAP2' {
        ext.args = params.direct_rna ? '-ax splice -uf -k14' : '-ax splice'
        publishDir = [
            path: {
                def proc = task.process.tokenize(':')[-1]
                "${params.outdir}/alignment/${meta.id}/${proc}"
            },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'BEDTOOLS_GENOMECOV' {
        ext.args = '-bg'
        publishDir = [
            path: {
                "${params.outdir}/alignment/bedtools_genomecov/"
            },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'BEDTOOLS_BAMTOBED' {
        publishDir = [
            path: {
                "${params.outdir}/alignment/bedtools_bamtobed/"
            },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SAMTOOLS_FAIDX' {
        publishDir = [
            path: {
                "${params.outdir}/alignment/samtools_faidx/"
            },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'UCSC_BEDTOBIGBED' {
        publishDir = [
            path: {
                "${params.outdir}/alignment/ucsc_bedtobigbed/"
            },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'UCSC_BEDGRAPHTOBIGWIG' {
        publishDir = [
            path: {
                "${params.outdir}/alignment/ucsc_bedgraphtobigwig/"
            },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'STRINGTIE2' {
        publishDir = [
            path: {
                def proc = task.process.tokenize(':')[-1]
                "${params.outdir}/quantification/samples/${meta.id}/${proc}"
            },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'STRINGTIE_MERGE' {
        publishDir = [
            path: {
                "${params.outdir}/quantification/stringtie_merge"
            },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'GFFCOMPARE_NOVEL_TRANSCRIPTS' {
        publishDir = [
            path: {
                "${params.outdir}/novel_transcripts/gffcompare"
            },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FILTER_GFFCOMPARE_CLASSES' {
        publishDir = [
            path: {
                "${params.outdir}/novel_transcripts/filter_gffcompare_classes"
            },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'GFFREAD_NOVEL_TRANSCRIPTS' {
        ext.args = '-w'
        publishDir = [
            path: {
                "${params.outdir}/novel_transcripts/gffread"
            },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SUBREAD_FEATURECOUNTS_GENES' {
        ext.args = '-L -g gene_id'
        publishDir = [
            path: {
                "${params.outdir}/quantification/featureCounts/"
            },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SUBREAD_FEATURECOUNTS_TRANSCRIPTS' {
        ext.args = '-L -g transcript_id --primary'
        publishDir = [
            path: {
                "${params.outdir}/quantification/featureCounts/"
            },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    //TRANSCRIPTOME

    withName: 'MINIMAP2_TRANSCRIPTOME' {
        ext.args = '-ax map-ont'
        ext.args2 = '-n'   // name-sort: oarfish needs natural (name-collated) order, not coordinate
        publishDir = [
            path: { "${params.outdir}/pseudoalignment/minimap2_transcriptome/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'OARFISH' {
        publishDir = [
            path: { "${params.outdir}/pseudoalignment/oarfish/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SALMON_QUANT|SALMON_INDEX' {
        publishDir = [
            path: {
                "${params.outdir}/pseudoalignment/salmon/"
            },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'TXIMETA_TXIMPORT|CUSTOM_TX2GENE' {
        publishDir = [
            path: {
                "${params.outdir}/pseudoalignment/merged_results/"
            },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'DRIMSEQ' {
        publishDir = [
            path: {
                "${params.outdir}/transcript_usage/drimseq/"
            },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'DEXSEQ' {
        publishDir = [
            path: {
                "${params.outdir}/transcript_usage/dexseq/"
            },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'ISOFORM_SWITCH' {
        publishDir = [
            path: {
                "${params.outdir}/transcript_usage/isoform_switch/"
            },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'DESEQ2_COMPARE' {
        publishDir = [
            path: {
                "${params.outdir}/differential_expression/"
            },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'DESEQ2_FIT' {
        publishDir = [
            path: {
                "${params.outdir}/differential_expression/"
            },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    //==========================
    // IDENTIFY_NOVEL_TRANSCRIPTS
    //==========================
    withName: 'GFFCOMPARE_NOVEL_TRANSCRIPTS' {
        cpus = 4
        memory = '8.GB'
        time = '2.h'
        publishDir = [
            path: { "${params.outdir}/novel_transcripts/gffcompare" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename }
        ]
    }

    withName: 'GFFREAD_NOVEL_TRANSCRIPTS' {
        cpus = 4
        memory = '8.GB'
        publishDir = [
            path: { "${params.outdir}/novel_transcripts/gffread" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'FILTER_GFFCOMPARE_CLASSES' {
        publishDir = [
            path: { "${params.outdir}/novel_transcripts/gffcompare/filter_classes" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'SQANTI3' {
        publishDir = [
            path: { "${params.outdir}/novel_transcripts/sqanti3" },
            mode: params.publish_dir_mode
        ]
    }

    //==========================
    // IDENTIFY_NOVEL_PROTEIN_CODING
    //==========================
    withName: 'CPAT_BUILD_MODEL' {
        cpus = 4
        memory = '8.GB'
        time = '2.h'
        publishDir = [
            path: { "${params.outdir}/identify_novel_protein_coding/cpat" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename }
        ]
    }

    withName: 'CPAT' {
        cpus = 4
        memory = '8.GB'
        publishDir = [
            path: { "${params.outdir}/identify_novel_protein_coding/cpat" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'PLEK_RUN|PLEK_PARSE' {
        publishDir = [
            path: { "${params.outdir}/identify_novel_protein_coding/plek" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'FEELNC_CODPOT_RUN|FEELNC_CODPOT_PARSE ' {
        publishDir = [
            path: { "${params.outdir}/identify_novel_protein_coding/feelnc" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'COMBINE_PREDICTIONS' {
        ext.args = params.consensus_mode
        publishDir = [
            path: { "${params.outdir}/identify_novel_protein_coding/combined_predictions" },
            mode: params.publish_dir_mode
        ]
    }

    //
    // POLY A
    //

    withName: 'NANOPOLISH_INDEX' {
        publishDir = [
            path: { "${params.outdir}/signal_analysis/index/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'NANOPOLISH_POLYA' {
        publishDir = [
            path: { "${params.outdir}/polya/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*:SIGNAL_ANALYSIS:SAMTOOLS_SORT' {
        ext.prefix = { "${meta.id}.transcriptome.coordsort" }
    }

    withName: 'NANOPOLISH_EVENTALIGN' {
        publishDir = [
            path: { "${params.outdir}/signal_analysis/eventalign/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}
