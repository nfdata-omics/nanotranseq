/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: FASTQC {
        ext.args = '--quiet'
    }

    withName: 'NFDATAOMICS_NANOTRANSEQ:NANOTRANSEQ:RAW_READS_QC:(FASTQC|TOULLIGQC|NANOPLOT)' {
        publishDir = [
            path: {
                def proc = task.process.tokenize(':')[-1]
                "${params.outdir}/qc/raw_reads/${meta.id}/${proc}"
            },
            mode: 'copy'
        ]
    }

    withName: 'NFDATAOMICS_NANOTRANSEQ:NANOTRANSEQ:DIRECT_RNA_QC:(FASTQC|TOULLIGQC|NANOPLOT|CHOPPER)' {
        publishDir = [
            path: {
                def proc = task.process.tokenize(':')[-1]
                "${params.outdir}/qc/post_chopper/${meta.id}/${proc}"
            },
            mode: 'copy'
        ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${task.process}".contains('DIRECT_RNA_QC') ? "${params.outdir}/qc/post_chopper/MULTIQC" : "${params.outdir}/qc/raw_reads/MULTIQC" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MINIMAP2_ALIGN|PARABRICKS_MINIMAP2' {
        publishDir = [
            path: {
                def proc = task.process.tokenize(':')[-1]
                "${params.outdir}/alignment/${meta.id}/${proc}"
            },
            mode: 'copy'
        ]
    }

    withName: 'GFFCOMPARE' {
        publishDir = [
            path: { "${params.outdir}/coding_potential/gffcompare" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FILTER_GTF' {
        publishDir = [
            path: { "${params.outdir}/coding_potential/novel_filter" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'GTF_TO_FASTA' {
        publishDir = [
            path: { "${params.outdir}/coding_potential/transcript_sequences" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'CPAT' {
        publishDir = [
            path: { "${params.outdir}/coding_potential/cpat" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'PLEK' {
        publishDir = [
            path: { "${params.outdir}/coding_potential/plek" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FEELNC_CODPOT' {
        publishDir = [
            path: { "${params.outdir}/coding_potential/feelnc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'COMBINE_CODING_POTENTIAL' {
        publishDir = [
            path: { "${params.outdir}/coding_potential/consensus" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}
