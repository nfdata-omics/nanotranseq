/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run nfdata-omics/nanotranseq -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]

    withName: 'FASTQC' {
        memory = '8.GB'
    }

    withName: 'STRINGTIE2' {
        memory = '8.GB'
    }

    withName: 'SALMON_QUANT' {
        ext.args = '--minScoreFraction 0.10 --minAssignedFrags 1'
    }

    // withName: 'TXIMETA_TXIMPORT' {
    //     cpus = 2
    //     memory = '8.GB'
    // }

}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Input data
    // TODO nf-core: Specify the paths to your test data on nf-core/test-datasets
    // TODO nf-core: Give any required params for the test so that command line flags are not needed
    input                           = params.pipelines_testdata_base_path + 'samplesheet.csv'
    fasta                           = params.pipelines_testdata_base_path + 'chr22_1-17550000.fa'
    gtf                             = params.pipelines_testdata_base_path + 'chr22_1-17500000.gtf'
    transcript_fasta                = params.pipelines_testdata_base_path + 'chr22-cdna.fa'
    use_gpus                        = false

    // The reads are direct cDNA: trim with Chopper, align without -uf
    direct_rna                      = false
    quantification_tool             = 'both'
    //pseudoaligner                   = 'oarfish'
    run_coding_potential            = true
    run_sqanti                      = true

    // poly(A) needs raw FAST5 from native RNA: not applicable to cDNA
    run_polya                       = false

    noncoding_testdata_base         = 'https://raw.githubusercontent.com/nfdata-omics/test-datasets/nanotranseq/noncoding'
    cpat_training_coding_fasta      = "${params.noncoding_testdata_base}/cds.fa"
    cpat_training_noncoding_fasta   = "${params.noncoding_testdata_base}/noncoding.fa"
    feelnc_mrna_fasta               = "${params.noncoding_testdata_base}/mrna.fa"
}
