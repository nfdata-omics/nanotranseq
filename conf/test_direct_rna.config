/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for the direct-RNA end-to-end test
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Runs the genome-based pipeline on native direct-RNA reads (HEK293T WT + METTL3-KO) with raw
    FAST5 signal, so the real poly(A) path (genome alignment -> nanopolish polya) is
    exercised end-to-end — unlike the module test, which uses a transcriptome reference.

    Genome: a mini-genome of 3 slices (RNF7/chr3, NANS/chr9, MRPL10/chr17) with rebased
    coordinates, plus the matching rebased GTF. Built from Ensembl; the direct-RNA reads
    map to exactly these three genes.

    DE is intentionally skipped (already covered by the cDNA test)

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]

    withName: 'FASTQC' {
        memory = '8.GB'
    }

    withName: 'STRINGTIE2' {
        memory = '8.GB'
    }
}

params {
    config_profile_name        = 'Direct-RNA test profile'
    config_profile_description = 'Native direct-RNA (HEK293T WT + METTL3-KO) end-to-end, genome-based, with poly(A)'
    drna_testdata_base              = 'https://raw.githubusercontent.com/nfdata-omics/test-datasets/nanotranseq/direct_rna'

    // Mini-genome (3 rebased slices) + matching rebased GTF; reads map to RNF7/NANS/MRPL10
    input                           = "${projectDir}/tests/data/directrna/samplesheet_directrna.csv"
    fasta                           = "${params.drna_testdata_base}/genome/drna_genome.fa"
    gtf                             = "${params.drna_testdata_base}/genome/drna.gtf"
    // fasta                           = "${projectDir}/tests/data/directrna/genome/drna_genome.fa"
    // gtf                             = "${projectDir}/tests/data/directrna/genome/drna.gtf"

    use_gpus                        = false
    direct_rna                      = true

    // quantification
    quantification_tool             = 'both'
    transcript_fasta                = "${params.drna_testdata_base}/genome/drna_transcriptome.fa"
    //transcript_fasta                = "${projectDir}/tests/data/directrna/genome/drna_transcriptome.fa"

    // poly(A) on: native RNA with FAST5 — this is the point of the test
    run_polya                       = true

    // Full structural/coding analysis (reuse CPAT training data from the cDNA test)
    run_coding_potential            = false
    run_sqanti                      = false

    // DE skipped: no deseq2_formula/comparisons set on purpose (covered by cDNA test)
}
