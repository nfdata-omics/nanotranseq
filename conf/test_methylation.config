/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for the direct-RNA RNA modification / methylation test
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Runs the signal-level modification branch on native direct-RNA reads
    (HEK293T-WT + METTL3-KO) with raw FAST5 signal: nanopolish eventalign against the
    transcriptome, then m6anet (per-sample m6A) and xpore (differential methylation).

    Same mini-genome and remote test data as the test_direct_rna profile.

    run_polya = false on purpose: the signal branch must be reachable through the
    modification flags alone, without poly(A) enabling it.

    quantification_tool = 'oarfish' is the realistic pairing — transcript-level quant and
    the modification analyses share the transcriptome alignment.

    METTL3 is the m6A methyltransferase, so WT vs METTL3-KO is the right contrast for
    xpore. With one replicate per condition it cannot estimate dispersion; the test asserts
    that the branch runs and produces its tables, not that sites are significant.

    Use as follows:
        nextflow run nfdata-omics/nanotranseq -profile test_methylation,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '2.h'
    ]

    withName: 'FASTQC' {
        memory = '8.GB'
    }

    withName: 'STRINGTIE2' {
        memory = '8.GB'
    }
}

params {
    config_profile_name        = 'Direct-RNA methylation test profile'
    config_profile_description = 'Native direct-RNA (WT + METTL3-KO) through eventalign, m6anet and xpore'

    // Same remote mini-genome as the direct-RNA profile; see conf/test_direct_rna.config.
    drna_testdata_base              = 'https://raw.githubusercontent.com/nfdata-omics/test-datasets/nanotranseq/direct_rna'

    input                           = "${projectDir}/tests/data/directrna/samplesheet_directrna.csv"
    fasta                           = "${params.drna_testdata_base}/genome/drna_genome.fa"
    gtf                             = "${params.drna_testdata_base}/genome/drna.gtf"

    use_gpus                        = false
    direct_rna                      = true

    // Transcript-level quant: shares MINIMAP2_TRANSCRIPTOME with the eventalign step.
    quantification_tool             = 'oarfish'
    transcript_fasta                = "${params.drna_testdata_base}/genome/drna_transcriptome.fa"

    // The point of this profile. poly(A) stays off: the signal branch has to be reachable
    // without it.
    run_polya                       = false
    run_rna_modifications           = true
    run_rna_methylation             = true

    // Skipped for the same reasons as in test_direct_rna: the mini-genome yields no
    // meaningful novel transcripts, so SQANTI3 and the coding-potential tools fail on
    // empty input.
    run_coding_potential            = false
    run_sqanti                      = false

    // DE skipped: no deseq2_formula/comparisons set on purpose (covered by cDNA test)
}
