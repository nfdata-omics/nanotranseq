params {
    // Same remote folder the test_direct_rna profile uses. Defined here because this
    // module test does not load that profile's config.
    drna_testdata_base = 'https://raw.githubusercontent.com/nfdata-omics/test-datasets/nanotranseq/direct_rna'
}

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]

    // Direct-RNA reads against a transcriptome reference: unspliced, so map-ont.
    withName: 'MINIMAP2_ALIGN' {
        ext.args = '-ax map-ont'
    }
}
